# ---------- Server ----------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/vendor_b2b_portal

# ---------- Auth ----------
# Use a long random string in production (e.g. openssl rand -hex 48)
JWT_SECRET=change_this_super_secret_key_in_production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ---------- CORS ----------
# Comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---------- Cloudinary (product images) ----------
# Leave blank to disable uploads - the product form falls back to a plain URL field
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=vendor-b2b-portal/products

# ---------- Seed super admin ----------
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=superadmin@portal.com
SEED_SUPERADMIN_PASSWORD=SuperAdmin@123
